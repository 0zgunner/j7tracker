# Ethereum wallet tracking
# Ethereum wallet tracking + risk scanning
ETHERSCAN_API_KEY=your_etherscan_key_here

# Optional: adds honeypot.is as an extra check on top of GoPlus (which is
# free/keyless and used by default). Get a free key at honeypot.is if you
# want this extra layer - not required for EVM risk scanning to work.
HONEYPOT_API_KEY=your_honeypot_is_key_here

# Push notifications - generate your own free keys with:
# npx web-push generate-vapid-keys
# (Claude generated a working pair for you in chat - paste those into your
# actual .env file and Netlify's environment variables, not here, since
# this .env.example file is meant to be committed to git.)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# Robinhood Chain wallet tracking (Blockscout explorer, no key required,
# but you can set a custom RPC provider key if you upgrade off the public endpoint)
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Solana wallet tracking - Helius free tier
HELIUS_API_KEY=your_helius_key_here

# Reddit trend tracking - requires a free "script" app from reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=J7Tracker/1.0 (by /u/your_reddit_username)

# News tracking (CoinDesk + Cointelegraph RSS) - no key required at all

# Live chat assistant - Groq (same as used in Purity)
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b
